{
    "name": "@arkade-os/wallet-providers",
    "version": "0.1.0",
    "description": "Browser wallet provider Identity implementations for Arkade SDK (UniSat, OKX, Leather, Phantom)",
    "license": "MIT",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./unisat": {
            "import": {
                "types": "./dist/providers/unisat.d.ts",
                "default": "./dist/providers/unisat.js"
            },
            "require": {
                "types": "./dist/providers/unisat.d.cts",
                "default": "./dist/providers/unisat.cjs"
            }
        },
        "./okx": {
            "import": {
                "types": "./dist/providers/okx.d.ts",
                "default": "./dist/providers/okx.js"
            },
            "require": {
                "types": "./dist/providers/okx.d.cts",
                "default": "./dist/providers/okx.cjs"
            }
        },
        "./leather": {
            "import": {
                "types": "./dist/providers/leather.d.ts",
                "default": "./dist/providers/leather.js"
            },
            "require": {
                "types": "./dist/providers/leather.d.cts",
                "default": "./dist/providers/leather.cjs"
            }
        },
        "./phantom": {
            "import": {
                "types": "./dist/providers/phantom.d.ts",
                "default": "./dist/providers/phantom.js"
            },
            "require": {
                "types": "./dist/providers/phantom.d.cts",
                "default": "./dist/providers/phantom.cjs"
            }
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "typecheck": "tsc --noEmit",
        "lint": "prettier --check src test",
        "smoke:dist": "node ../../config/smoke-dist.mjs",
        "test": "vitest run",
        "test:unit": "vitest run --exclude test/e2e"
    },
    "peerDependencies": {
        "@arkade-os/sdk": ">=0.4.15 <1.0.0"
    },
    "dependencies": {
        "@scure/base": "^2.0.0"
    },
    "devDependencies": {
        "@arkade-os/sdk": "workspace:*"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/arkade-os/ts-sdk.git",
        "directory": "packages/wallet-providers"
    },
    "keywords": [
        "arkade",
        "bitcoin",
        "wallet",
        "unisat",
        "okx",
        "leather",
        "phantom",
        "psbt"
    ]
}
