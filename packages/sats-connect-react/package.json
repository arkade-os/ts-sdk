{
    "name": "@arkade-os/sats-connect-react",
    "version": "0.1.0",
    "description": "React bindings for Arkade SDK with Sats Connect wallets",
    "license": "MIT",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "typecheck": "tsc --noEmit",
        "lint": "biome format src test",
        "format": "biome format --write src test",
        "smoke:dist": "node ../../config/smoke-dist.mjs",
        "test": "vitest run",
        "test:unit": "vitest run --exclude test/e2e"
    },
    "peerDependencies": {
        "@arkade-os/sdk": ">=0.5.4 <1.0.0",
        "@arkade-os/swap": ">=0.1.15 <0.2.0",
        "nostr-tools": ">=2.24.1 <3.0.0",
        "react": ">=18.0.0",
        "sats-connect": ">=4.0.0"
    },
    "dependencies": {
        "@arkade-os/sats-connect": "workspace:^"
    },
    "devDependencies": {
        "@arkade-os/sdk": "workspace:*",
        "@arkade-os/swap": "workspace:*",
        "@types/react": "^18.3.0",
        "@types/react-dom": "^18.3.0",
        "happy-dom": "^21.0.4",
        "react": "^18.3.0",
        "react-dom": "^18.3.0",
        "sats-connect": "^4.2.1"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/arkade-os/ts-sdk.git",
        "directory": "packages/sats-connect-react"
    },
    "keywords": [
        "arkade",
        "bitcoin",
        "sats-connect",
        "xverse",
        "react",
        "wallet"
    ]
}
