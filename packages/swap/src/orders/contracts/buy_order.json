  "source": {
    "entry": "buy_order.ark",
    "files": {
      "buy_order.ark": "pragma arkade ^0.1.0;\n\n// Standing order to buy `asset` at `price` sats per unit from a funded budget. The continuation at the\n// order's own input index keeps the unspent budget (never below `reserve`) and accumulates bought units.\ncontract BuyOrder(\n  pubkey maker,\n  bytes32 makerProgram,\n  bytes32 assetTxid, int assetGidx,\n  int price,\n  int minFill,\n  int expiresAt,\n  int reserve\n) {\n  // Every fill spends at least 330 sats. The fill that leaves less budget than the next legal fill\n  // (min fill, and at least 330 sats) pays the maker directly.\n  function fill(int qty) {\n    int i = this.activeInputIndex;\n    int spend = qty * price;\n    int left = tx.input.current.value - spend - reserve;\n    let h = tx.inputs[i].assets.tryLookup(assetTxid, assetGidx);\n    int held = 0;\n    if (h.found) {\n      held = h.amount;\n    }\n    let out = tx.outputs[i].script;\n    let own = tx.input.current.script;\n    require(qty > 0 && left >= 0, \"qty\");\n    require(expiresAt == 0 || !checkTime(expiresAt), \"expired\");\n    require(spend >= 330, \"below 330 sats\");\n    require(qty >= minFill || left < minFill * price || left < 330, \"below min fill\");\n    require(out.version == 1, \"output version\");\n    require(tx.outputs[i].value >= tx.input.current.value - spend, \"overspend\");\n    require(tx.outputs[i].assets.length == 1 && tx.outputs[i].assets.lookup(assetTxid, assetGidx) == held + qty, \"delivery\");\n    require(\n      ((left < minFill * price || left < 330) && out.program == makerProgram) ||\n        (left >= minFill * price && left >= 330 && out.program == own.program),\n      \"continuation\"\n    );\n  }\n\n  // Anyone may return an expired order to the maker. No asset opcodes: OP_TUNNEL also covers an asset-free coin.\n  function settle() {\n    int i = this.activeInputIndex;\n    let out = tx.outputs[i].script;\n    require(expiresAt > 0 && checkTime(expiresAt), \"still live\");\n    require(out.program == makerProgram, \"maker\");\n    require(out.version == 1, \"maker version\");\n    require(this.tunnel(i, {script: false, value: true, assets: true}), \"settle\");\n  }\n\n  function renew() {\n    require(tx.version == 2, \"intent only\");\n    require(this.tunnel(this.activeInputIndex - 1), \"tunnel\");\n  }\n\n  function cancel(signature makerSig, signature serverSig) tapscript {\n    require(checkMultisig([maker, server], [makerSig, serverSig]));\n  }\n\n  function unilateral(signature makerSig) tapscript {\n    require(older(serverExitDelay));\n    require(checkSig(makerSig, maker));\n  }\n}\n"
    }
  },
