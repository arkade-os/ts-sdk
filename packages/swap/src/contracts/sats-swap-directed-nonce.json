  "source": {
    "entry": "sats-swap-directed-nonce.ark",
    "files": {
      "sats-swap-directed-nonce.ark": "pragma arkade ^0.1.0;\n\ncontract SatsSwapDirectedNonce(\n    pubkey receiver,\n    int amount,\n    pubkey user,\n    pubkey taker,\n    bytes32 nonce\n) {\n    function fulfill() {\n        @allow(self-comparison, \"commits the nonce without imposing a spend condition\")\n        require(nonce == nonce);\n        int i = this.activeInputIndex;\n        require(tx.outputs[i].value >= amount);\n        let paid = tx.outputs[i].script;\n        require(paid.version == 1);\n        require(paid.program == receiver);\n    }\n\n    function fulfill(signature takerSig, signature operatorSig) tapscript {\n        require(checkMultisig([taker, tweak(operator, fulfill)], [takerSig, operatorSig]));\n    }\n\n    function cancel(signature userSig, signature operatorSig) tapscript {\n        require(checkMultisig([user, operator], [userSig, operatorSig]));\n    }\n}\n"
    }
  },
