pragma arkade ^0.1.0;

contract SatsSwapDirectedNonce(
    pubkey receiver,
    int amount,
    pubkey user,
    pubkey taker,
    bytes32 nonce
) {
    function fulfill() {
        @allow(self-comparison, "commits the nonce without imposing a spend condition")
        require(nonce == nonce);
        int i = this.activeInputIndex;
        require(tx.outputs[i].value >= amount);
        let paid = tx.outputs[i].script;
        require(paid.version == 1);
        require(paid.program == receiver);
    }

    function fulfill(signature takerSig, signature operatorSig) tapscript {
        require(checkMultisig([taker, tweak(operator, fulfill)], [takerSig, operatorSig]));
    }

    function cancel(signature userSig, signature operatorSig) tapscript {
        require(checkMultisig([user, operator], [userSig, operatorSig]));
    }
}
