# swap arkade-regtest overrides — the RFQ corridor's stack.
#
# A SECOND profile rather than a knob on `.env.regtest`, because the two swap
# corridors need opposite timelock types and one arkd cannot serve both.
# `packages/boltz-swap/.env.regtest` states the rule from the block side: all
# five timelocks must be set and share a type, and arkd accepts block-typed
# VHTLC locktimes only when its own vtxo tree expiry is block-typed.
#
# RFQ is the mirror image. `lightningSendVtxoScript` emits `seconds` on all
# three unilateral tiers, and `unilateralClaimDelay` refuses a server exit delay
# below 512s outright — so on the offer suite's block-typed stack
# (`ARKD_UNILATERAL_EXIT_DELAY=20`) `requestLightningSend` throws before it ever
# reaches a quote. Everything here is therefore seconds-typed.

ARKD_IMAGE=ghcr.io/arkade-os/arkd:v0.9.14
ARKD_WALLET_IMAGE=ghcr.io/arkade-os/arkd-wallet:v0.9.14

# All five ≥ 512 so arkd reads them as seconds, and each above the SDK's own
# regtest floor: batch expiry ≥ REGTEST_MIN_BATCH_EXPIRY_SECONDS (6000) and
# checkpoint exit delay ≥ REGTEST_MIN_CHECKPOINT_EXIT_DELAY_SECONDS (1200), or
# the wallet rejects the server's own parameters at setup.
ARKD_VTXO_TREE_EXPIRY=7200
ARKD_BOARDING_EXIT_DELAY=4096
ARKD_UNILATERAL_EXIT_DELAY=2048
ARKD_PUBLIC_UNILATERAL_EXIT_DELAY=2048
ARKD_CHECKPOINT_EXIT_DELAY=2048
ARKD_VTXO_MIN_AMOUNT=1

# Seconds-denominated locktimes expire on wall clock, so mining is not what
# fires them — but the auto-miner is still off, so nothing advances mid-suite
# except what a test asks for.
AUTOMINE_INTERVAL=0

# Zero fees — the suite funds a lockup without a fee budget
ARK_OFFCHAIN_INPUT_FEE="0.0"
ARK_ONCHAIN_INPUT_FEE="0.0"
ARK_OFFCHAIN_OUTPUT_FEE="0.0"
ARK_ONCHAIN_OUTPUT_FEE="0.0"
