# Regtest overrides for the lightning-send example:
#
#   node regtest/regtest.mjs start --env packages/swap/examples/node/regtest.env
#
# The lightning-send covenant's unilateral-claim leaf is a BIP68 SECONDS-based
# CSV, so `unilateralClaimDelay` rejects any exit delay below 512 as a block
# count. The stack's defaults — and both package profiles — are block
# denominated, hence the values below. arkd reads a locktime as blocks when it
# is under 512 and as seconds otherwise, so all four have to move together.
REGTEST_PROFILES=emulator

ARKD_UNILATERAL_EXIT_DELAY=4096
ARKD_PUBLIC_UNILATERAL_EXIT_DELAY=4096
ARKD_CHECKPOINT_EXIT_DELAY=4096
ARKD_BOARDING_EXIT_DELAY=8192
ARKD_VTXO_TREE_EXPIRY=604672
