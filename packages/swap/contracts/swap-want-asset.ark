pragma arkade ^0.1.0;

contract SwapWantAsset(
  pubkey makerWP,
  int wantAmount,
  bytes32 wantAssetTxid,
  int wantAssetGroupIndex,
  pubkey user
) {
  function fulfill() {
    require(tx.outputs[0].assets.lookup(wantAssetTxid, wantAssetGroupIndex) >= wantAmount);
    require(tx.outputs[0].witnessVersion == 1);
    require(tx.outputs[0].scriptPubKey == makerWP);
  }

  function cancel(signature userSig, signature serverSig) tapscript {
    require(checkMultisig([user, server], [userSig, serverSig], 2));
  }
}
