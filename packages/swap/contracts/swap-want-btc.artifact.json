    "codeHash": "sha256:266fd6542ec0e4a203237d5426332df3e8186b7bd3e843d4f51dc479e67e2fc2",
    "source": {
        "entry": "swap-want-btc.ark",
        "files": {
            "swap-want-btc.ark": "pragma arkade ^0.1.0;\n\ncontract SwapWantBtc(\n  pubkey makerWP,\n  int wantAmount,\n  pubkey user\n) {\n  function fulfill() {\n    require(tx.outputs[0].value >= wantAmount);\n    let recipient = tx.outputs[0].script;\n    require(recipient.version == 1);\n    require(recipient.program == makerWP);\n  }\n\n  function cancel(signature userSig, signature serverSig) tapscript {\n    require(checkMultisig([user, server], [userSig, serverSig], 2));\n  }\n}\n"
        }
    },
