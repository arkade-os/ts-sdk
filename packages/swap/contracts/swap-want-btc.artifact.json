    "source": {
        "entry": "swap-want-btc.ark",
        "files": {
            "swap-want-btc.ark": "pragma arkade ^0.1.0;\n\ncontract SwapWantBtc(\n  pubkey makerWP,\n  int wantAmount,\n  pubkey user\n) {\n  function fulfill() {\n    require(tx.outputs[0].value >= wantAmount);\n    require(tx.outputs[0].witnessVersion == 1);\n    require(tx.outputs[0].scriptPubKey == makerWP);\n  }\n\n  function cancel(signature userSig, signature serverSig) tapscript {\n    require(checkMultisig([user, server], [userSig, serverSig], 2));\n  }\n}\n"
        }
    },
