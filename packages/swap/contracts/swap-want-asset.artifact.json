    "codeHash": "sha256:2bc50372aeb77d76235f8b85e2d3231b9e9cddbbf84183e5e925d60171583486",
    "source": {
        "entry": "swap-want-asset.ark",
        "files": {
            "swap-want-asset.ark": "pragma arkade ^0.1.0;\n\ncontract SwapWantAsset(\n  pubkey makerWP,\n  int wantAmount,\n  bytes32 wantAssetTxid,\n  int wantAssetGroupIndex,\n  pubkey user\n) {\n  function fulfill() {\n    require(tx.outputs[0].assets.lookup(wantAssetTxid, wantAssetGroupIndex) >= wantAmount);\n    let recipient = tx.outputs[0].script;\n    require(recipient.version == 1);\n    require(recipient.program == makerWP);\n  }\n\n  function cancel(signature userSig, signature serverSig) tapscript {\n    require(checkMultisig([user, server], [userSig, serverSig], 2));\n  }\n}\n"
        }
    },
