  "source": {"entry": "banco-btc-to-asset.ark", "files": {"banco-btc-to-asset.ark": "pragma arkade ^0.1.0;\ncontract BancoBtcToAsset(pubkey makerWP, int wantAmount, bytes32 wantAssetTxid, int wantAssetGroupIndex, pubkey user) {\n  function fulfill() {\n    require(tx.outputs[0].assets.lookup(wantAssetTxid, wantAssetGroupIndex) >= wantAmount);\n    let recipient = tx.outputs[0].script;\n    require(recipient.version == 1);\n    require(recipient.program == makerWP);\n  }\n  function cancel(signature userSig, signature serverSig) tapscript {\n    require(checkMultisig([user, server], [userSig, serverSig], 2));\n  }\n}\n"}},
