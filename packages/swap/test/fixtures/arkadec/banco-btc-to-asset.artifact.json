      },
      "leaves": [{ "name": "fulfill", "witness": [{"name": "serverSig", "type": "signature", "encoding": "schnorr-64", "injected": true}, {"name": "emulatorSig", "type": "signature", "encoding": "schnorr-64", "injected": true}], "asm": ["<SERVER_KEY>", "OP_CHECKSIGVERIFY", "<EMULATOR_KEY:fulfill>", "OP_CHECKSIG"] }]
