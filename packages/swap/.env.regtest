# swap arkade-regtest overrides — mirrors ts-sdk's: the swap e2e drives the
# same arkd + emulator pair the SDK suites use.

ARKD_IMAGE=ghcr.io/arkade-os/arkd:v0.9.16
ARKD_WALLET_IMAGE=ghcr.io/arkade-os/arkd-wallet:v0.9.16

ARKD_VTXO_TREE_EXPIRY=20
ARKD_BOARDING_EXIT_DELAY=40
ARKD_CHECKPOINT_EXIT_DELAY=20
ARKD_UNILATERAL_EXIT_DELAY=20
ARKD_PUBLIC_UNILATERAL_EXIT_DELAY=20
ARKD_VTXO_MIN_AMOUNT=1

# Block-denominated locktimes above require this per regtest/.env.defaults: the
# background auto-miner would otherwise advance the tip and fire sweeps/expiry
# at an uncontrolled point mid-suite.
AUTOMINE_INTERVAL=0

# Zero fees — the suite funds and cancels offers without a fee budget
ARK_OFFCHAIN_INPUT_FEE="0.0"
ARK_ONCHAIN_INPUT_FEE="0.0"
ARK_OFFCHAIN_OUTPUT_FEE="0.0"
ARK_ONCHAIN_OUTPUT_FEE="0.0"

# No intent solver here. This is the OFFER stack — swap.test.ts says in its own
# header that no solver runs in it — and starting one is not free: it spends
# from the same ark client wallet the suite faucets from, which showed up as
# `intent-solver float failed: not enough funds` alongside a round that failed
# with `missing forfeit transactions`. The claim-packet suite that does need a
# solver runs on .env.regtest.rfq, where the same funding works.
INTENT_SOLVER_IMAGE=
