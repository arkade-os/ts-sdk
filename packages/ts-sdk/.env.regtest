# ts-sdk arkade-regtest overrides

ARKD_IMAGE=ghcr.io/arkade-os/arkd:v0.9.14
ARKD_WALLET_IMAGE=ghcr.io/arkade-os/arkd-wallet:v0.9.14

# Resolves to base,ark,delegate,emulator. The default is every tier, which since
# the upgrade also starts the solver, strfry, bucket-sync and the Boltz/LND
# stack — none of which this suite or its setup waiter touches, and whose only
# effect on a 2-core CI runner is contention that widens timing windows.
REGTEST_PROFILES=delegate,emulator

# Match old ts-sdk docker-compose arkd config
ARKD_VTXO_TREE_EXPIRY=20
ARKD_BOARDING_EXIT_DELAY=40
ARKD_CHECKPOINT_EXIT_DELAY=20
ARKD_UNILATERAL_EXIT_DELAY=20
ARKD_PUBLIC_UNILATERAL_EXIT_DELAY=20
ARKD_VTXO_MIN_AMOUNT=1

# Block-denominated locktimes above require this per regtest/.env.defaults: the
# background auto-miner would otherwise advance the tip and fire sweeps/expiry
# (or mature a test's CLTV) at an uncontrolled point mid-suite.
AUTOMINE_INTERVAL=0

# Zero fees — ts-sdk tests manage fees individually via setFees()/clearFees()
ARK_OFFCHAIN_INPUT_FEE="0.0"
ARK_ONCHAIN_INPUT_FEE="0.0"
ARK_OFFCHAIN_OUTPUT_FEE="0.0"
ARK_ONCHAIN_OUTPUT_FEE="0.0"

# Leave fulmine-delegator's own wallet empty. It reads arkd's block-typed
# `ARKD_VTXO_TREE_EXPIRY=20` above as 20 *seconds*, so any vtxo it holds is
# born expired and its scheduler renews it in every round, forever. Each
# renewal locks another note-sized batch output of arkd liquidity until the
# batch is swept — with the auto-miner off, never — so a 1 BTC delegator burns
# arkd's whole 20 BTC in ~100s and every later round it joins dies on "not
# enough liquidity", dropping the co-registered intents of whatever test shared
# that round. Unfunded, it has nothing to renew and only joins the rounds the
# delegate tests ask it to. `arkd note --amount 0` is refused, which is exactly
# the intent: the regtest setup warns and leaves the wallet unfunded.
FULMINE_NOTE_AMOUNT=0
