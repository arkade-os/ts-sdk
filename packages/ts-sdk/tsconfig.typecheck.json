// The package tsconfig excludes `test/`, so a `.test-d.ts` assertion is a
// silent no-op unless this config includes it.
{
    "extends": "./tsconfig.json",
    "include": ["src/**/*.ts", "test/**/*.test-d.ts", "../../config/types/**/*.d.ts"],
    "exclude": ["node_modules", "dist", "test/e2e", "examples"]
}
