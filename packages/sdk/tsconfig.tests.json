// Typechecks every test, which `tsconfig.json` excludes.
//
// The exclusion is how 89 `Wallet.create({ arkServerUrl })` call sites survived the
// removal of that field: the key was silently ignored, every e2e wallet booted
// against the public mainnet default, and all six CI integration groups went red
// with no compile error anywhere. Excess-property checking catches exactly that,
// and costs nothing here.
{
    "extends": "./tsconfig.json",
    "include": ["src", "test", "../../config/types/**/*.d.ts"],
    "exclude": ["node_modules", "dist"]
}
