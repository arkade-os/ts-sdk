pragma arkade ^0.1.0;

import "struct_vault.ark";
import "single_sig.ark";

// Moves a coin into a vault under the same policy, with a fee to a fixed key.
contract Relay(Policy policy) {
  @allow(unsigned-spend-path, "the outputs pay the vault and the fee key")
  function relay() {
    require(tx.outputs[0].script == new StructVault(policy));
    require(tx.outputs[1].script == new SingleSig(0x79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798));
  }

  function unilateral(signature sig) tapscript {
    require(older(policy.exitDelay));
    require(checkSig(sig, policy.primary.key));
  }
}
