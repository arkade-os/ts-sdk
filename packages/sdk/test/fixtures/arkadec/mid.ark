pragma arkade ^0.1.0;

import "leaf.ark";

contract Mid(pubkey k, pubkey other) {
  @allow(unsigned-spend-path, "test")
  function go() {
    require(tx.outputs[0].script == new Leaf(other));
  }

  function exit(signature s, signature t) tapscript {
    require(after(500000000));
    require(checkMultisig([k, operator], [s, t]));
  }
}
