  "source": {
    "entry": "renewable.ark",
    "files": {
      "renewable.ark": "pragma arkade ^0.1.0;\n\n// A coin anyone may renew into a new batch without the owner's key.\ncontract Renewable(pubkey owner) {\n  function renew() {\n    require(tx.version == 2, \"intent only\");\n    require(this.tunnel(this.activeInputIndex - 1), \"tunnel\");\n  }\n\n  function unilateral(signature ownerSig) tapscript {\n    require(older(operatorExitDelay));\n    require(checkSig(ownerSig, owner));\n  }\n}\n"
    }
  },
