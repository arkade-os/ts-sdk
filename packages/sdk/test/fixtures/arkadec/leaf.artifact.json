    "files": {
      "leaf.ark": "pragma arkade ^0.1.0;\n\ncontract Leaf(pubkey k) {\n  function spend(signature s) {\n    require(checkSig(s, k));\n  }\n\n  function unilateral(signature s) tapscript {\n    require(older(operatorExitDelay));\n    require(checkSig(s, k));\n  }\n}\n"
    }
