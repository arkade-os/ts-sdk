    "files": {
      "leaf.ark": "pragma arkade ^0.1.0;\n\ncontract Leaf(pubkey k) {\n  function spend(signature s) {\n    require(checkSig(s, k));\n  }\n\n  function unilateral(signature s) tapscript {\n    require(older(operatorExitDelay));\n    require(checkSig(s, k));\n  }\n}\n",
      "mid.ark": "pragma arkade ^0.1.0;\n\nimport \"leaf.ark\";\n\ncontract Mid(pubkey k, pubkey other) {\n  @allow(unsigned-spend-path, \"test\")\n  function go() {\n    require(tx.outputs[0].script == new Leaf(other));\n  }\n\n  function exit(signature s, signature t) tapscript {\n    require(after(500000000));\n    require(checkMultisig([k, operator], [s, t]));\n  }\n}\n"
    }
