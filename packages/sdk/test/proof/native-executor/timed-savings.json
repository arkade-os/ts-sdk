    "source": {
        "entry": "timed-savings.ark",
        "files": {
            "timed-savings.ark": "contract TimedSavings(pubkey owner, bytes32 payout, int releaseAt, int exitSequence) {\n  function release() {\n    require(tx.numInputs == 1, \"one position\");\n    require(tx.numOutputs == 3, \"payout extension and anchor\");\n    require(checkTime(releaseAt), \"still locked\");\n    ScriptPubKey destination = { program: payout, version: 1 };\n    require(tx.outputs[0].script == destination, \"committed payout\");\n    require(tx.outputs[0].value == tx.input.current.value, \"preserve principal\");\n    require(tx.outputs[1].value == 0, \"zero value extension\");\n    require(tx.outputs[2].value == 0, \"zero value anchor\");\n  }\n\n  function release(signature serverSig, signature emulatorSig) tapscript {\n    require(after(releaseAt));\n    require(checkMultisig([server, emulator], [serverSig, emulatorSig], 2));\n  }\n\n  function renew() {\n    require(!checkTime(releaseAt), \"mature savings must release\");\n    require(tx.version == 2, \"batch intent\");\n    require(tx.numInputs == 2, \"message and position\");\n    require(this.activeInputIndex == 1, \"position index\");\n    require(tx.outputs[0].script == tx.input.current.script, \"same contract\");\n    require(tx.outputs[0].value == tx.input.current.value, \"preserve principal\");\n  }\n\n  function unilateral(signature ownerSig) tapscript {\n    require(older(exitSequence));\n    require(checkSig(ownerSig, owner));\n  }\n}\n"
        }
    },
