# SDK arkade-regtest overrides for test/e2e/executor.test.ts
#
# The executor daemon renews a coin when its expiry comes within the renewal
# window, by wall-clock time, so arkd runs seconds-typed timelocks here (the
# sdk stack's are block-typed with the auto-miner off). Values match the
# executor repo's own regtest stack.
REGTEST_PROFILES=executor

ARKD_VTXO_TREE_EXPIRY=512
ARKD_BOARDING_EXIT_DELAY=1024
ARKD_CHECKPOINT_EXIT_DELAY=512
ARKD_UNILATERAL_EXIT_DELAY=512
ARKD_PUBLIC_UNILATERAL_EXIT_DELAY=512
ARKD_VTXO_MIN_AMOUNT=1

ARK_OFFCHAIN_INPUT_FEE="0.0"
ARK_ONCHAIN_INPUT_FEE="0.0"
ARK_OFFCHAIN_OUTPUT_FEE="0.0"
ARK_ONCHAIN_OUTPUT_FEE="0.0"
