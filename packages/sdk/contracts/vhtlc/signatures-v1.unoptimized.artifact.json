    "source": {
        "entry": "signatures-v1.ark",
        "files": {
            "signatures-v1.ark": "pragma arkade ^0.1.0;\n\ncontract VHTLCSignaturesV1(\n    pubkey sender,\n    pubkey receiver,\n    bytes20 preimageHash,\n    int refundLocktime,\n    int claimSequence,\n    int refundSequence,\n    int refundWithoutReceiverSequence\n) {\n    function claim(bytes preimage, signature receiverSig, signature serverSig) tapscript {\n        require(hash160(preimage) == preimageHash);\n        require(checkMultisig([receiver, server], [receiverSig, serverSig], 2));\n    }\n\n    function refund(signature senderSig, signature receiverSig, signature serverSig) tapscript {\n        require(checkMultisig([sender, receiver, server], [senderSig, receiverSig, serverSig], 3));\n    }\n\n    function refundWithoutReceiver(signature senderSig, signature serverSig) tapscript {\n        require(after(refundLocktime));\n        require(checkMultisig([sender, server], [senderSig, serverSig], 2));\n    }\n\n    function unilateralClaim(bytes preimage, signature receiverSig) tapscript {\n        require(hash160(preimage) == preimageHash);\n        require(older(claimSequence));\n        require(checkSig(receiverSig, receiver));\n    }\n\n    function unilateralRefund(signature senderSig, signature receiverSig) tapscript {\n        require(older(refundSequence));\n        require(checkMultisig([sender, receiver], [senderSig, receiverSig], 2));\n    }\n\n    function unilateralRefundWithoutReceiver(signature senderSig) tapscript {\n        require(older(refundWithoutReceiverSequence));\n        require(checkSig(senderSig, sender));\n    }\n}\n"
        }
    },
