  "codeHash": "sha256:5d58e749e6ddcd46b30add050f3a2d13537a991e063974034d2d5c3d5b8bc11b",
  "source": {
    "entry": "arkade-htlc.ark",
    "files": {
      "arkade-htlc.ark": "pragma arkade ^0.1.0;\n\n// Arkade HTLC: an offchain lockup. Covenant paths are co-signed by the operator key alone,\n// tweaked by the covenant they enforce, and the claim pays at least the agreed amount.\ncontract ArkadeHTLC(\n  pubkey sender,\n  pubkey receiver,\n  bytes20 preimageHash,\n  int refundLocktime,\n  int unilateralClaimDelay,\n  int unilateralRefundDelay,\n  int unilateralRefundWithoutReceiverDelay,\n  bytes32 receiverScript,\n  bytes32 senderScript,\n  int amount,\n  AssetId asset,\n  int assetAmount\n) {\n  @allow(unsigned-spend-path, \"nonInteractiveClaim also needs the preimage, and pays the receiver\")\n  function payReceiver() {\n    int i = this.activeInputIndex;\n    let paid = tx.outputs[i].script;\n    require(paid.version == 1);\n    require(paid.program == receiverScript);\n    require(tx.outputs[i].value >= max(tx.input.current.value, amount));\n    require(this.tunnel(i, {script: false, value: false, assets: true}));\n    if (assetAmount > 0) {\n      require(tx.outputs[i].assets.lookup(asset) >= assetAmount);\n    }\n  }\n\n  @allow(unsigned-spend-path, \"the refund covenants pay the sender\")\n  function paySender() {\n    int i = this.activeInputIndex;\n    let paid = tx.outputs[i].script;\n    require(paid.version == 1);\n    require(paid.program == senderScript);\n    require(tx.outputs[i].value >= tx.input.current.value);\n    require(this.tunnel(i, {script: false, value: false, assets: true}));\n  }\n\n  function claim(bytes32 preimage, signature receiverSig, signature operatorSig) tapscript {\n    require(hash160(preimage) == preimageHash);\n    require(checkMultisig([receiver, operator], [receiverSig, operatorSig]));\n  }\n\n  function refund(signature senderSig, signature receiverSig, signature operatorSig) tapscript {\n    require(checkMultisig([sender, receiver, operator], [senderSig, receiverSig, operatorSig]));\n  }\n\n  function refundWithoutReceiver(signature senderSig, signature operatorSig) tapscript {\n    require(after(refundLocktime));\n    require(checkMultisig([sender, operator], [senderSig, operatorSig]));\n  }\n\n  function unilateralClaim(bytes32 preimage, signature receiverSig) tapscript {\n    require(hash160(preimage) == preimageHash);\n    require(older(unilateralClaimDelay));\n    require(checkSig(receiverSig, receiver));\n  }\n\n  function unilateralRefund(signature senderSig, signature receiverSig) tapscript {\n    require(older(unilateralRefundDelay));\n    require(checkMultisig([sender, receiver], [senderSig, receiverSig]));\n  }\n\n  function unilateralRefundWithoutReceiver(signature senderSig) tapscript {\n    require(older(unilateralRefundWithoutReceiverDelay));\n    require(checkSig(senderSig, sender));\n  }\n\n  function nonInteractiveClaim(bytes32 preimage, signature operatorSig) tapscript {\n    require(hash160(preimage) == preimageHash);\n    require(checkSig(operatorSig, tweak(operator, payReceiver)));\n  }\n\n  function nonInteractiveRefund(signature receiverSig, signature operatorSig) tapscript {\n    require(checkMultisig([receiver, tweak(operator, paySender)], [receiverSig, operatorSig]));\n  }\n\n  function nonInteractiveRefundWithoutReceiver(signature operatorSig) tapscript {\n    require(after(refundLocktime));\n    require(checkSig(operatorSig, tweak(operator, paySender)));\n  }\n}\n"
    }
  },
