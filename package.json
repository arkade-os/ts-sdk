{
    "name": "arkade-monorepo",
    "private": true,
    "packageManager": "pnpm@10.25.0",
    "engines": {
        "node": ">=24.15.0 <27",
        "pnpm": ">=10.25.0 <11"
    },
    "scripts": {
        "build": "pnpm -r build",
        "test": "pnpm run test:unit && pnpm run test:integration",
        "test:unit": "pnpm -r test:unit",
        "test:integration": "pnpm run test:integration:sdk && pnpm run test:integration:swap && pnpm run test:integration:swap-rfq",
        "test:integration:sdk": "bash scripts/regtest.sh sdk groups",
        "test:integration:swap": "bash scripts/regtest.sh swap cycle",
        "test:integration:swap-rfq": "bash scripts/regtest.sh swap-rfq cycle",
        "lint": "biome format config && pnpm -r lint",
        "format": "biome format --write config && pnpm -r format",
        "release": "node scripts/release.mjs",
        "release:dry-run": "node scripts/release.mjs --dry-run",
        "release:cleanup": "node scripts/release.mjs --cleanup",
        "regtest:up:sdk": "bash scripts/regtest.sh sdk up",
        "regtest:up:swap": "bash scripts/regtest.sh swap up",
        "regtest:up:swap-rfq": "bash scripts/regtest.sh swap-rfq up",
        "regtest:up:sdk-delegatee": "bash scripts/regtest.sh sdk-delegatee up",
        "regtest:setup:sdk": "bash scripts/regtest.sh sdk setup",
        "regtest:setup:swap": "bash scripts/regtest.sh swap setup",
        "regtest:setup:swap-rfq": "bash scripts/regtest.sh swap-rfq setup",
        "regtest:setup:sdk-delegatee": "bash scripts/regtest.sh sdk-delegatee setup",
        "regtest:test:sdk": "bash scripts/regtest.sh sdk test",
        "regtest:test:swap": "bash scripts/regtest.sh swap test",
        "regtest:test:swap-rfq": "bash scripts/regtest.sh swap-rfq test",
        "regtest:test:sdk-delegatee": "bash scripts/regtest.sh sdk-delegatee test",
        "regtest:down:sdk": "bash scripts/regtest.sh sdk down",
        "regtest:down:swap": "bash scripts/regtest.sh swap down",
        "regtest:down:swap-rfq": "bash scripts/regtest.sh swap-rfq down",
        "regtest:down:sdk-delegatee": "bash scripts/regtest.sh sdk-delegatee down",
        "regtest:reset:sdk": "bash scripts/regtest.sh sdk reset",
        "regtest:reset:swap": "bash scripts/regtest.sh swap reset",
        "regtest:reset:swap-rfq": "bash scripts/regtest.sh swap-rfq reset",
        "regtest:reset:sdk-delegatee": "bash scripts/regtest.sh sdk-delegatee reset",
        "prepare": "husky"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.9",
        "@types/node": "24.3.1",
        "eventsource": "4.1.0",
        "fake-indexeddb": "6.2.5",
        "husky": "9.1.7",
        "tsup": "^8.5.0",
        "typescript": "5.9.2",
        "vitest": "3.2.7"
    }
}
